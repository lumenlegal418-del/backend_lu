# Cadena de conexión a Neon/PostgreSQL (usa el driver asyncpg)
# Ejemplo Neon: postgresql+asyncpg://usuario:password@ep-xxxxx.neon.tech/dbname
DATABASE_URL=postgresql+asyncpg://usuario:password@host/dbname

# Orígenes permitidos para CORS (separados por coma), ej: http://localhost:5173,https://mi-front.com
BACKEND_CORS_ORIGINS=http://localhost:5173
